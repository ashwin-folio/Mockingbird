# Mockingbird Environment Configuration
# =====================================
# Copy this file to .env and fill in your values
# Keep .env private - never commit it to version control

# REQUIRED: OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
# 1. Sign up or log in at https://openrouter.ai
# 2. Go to Keys section
# 3. Create a new key named "Mockingbird"
# 4. Copy the key (starts with "sk-or-")
OPENROUTER_API_KEY=sk-or-your-key-here

# OPTIONAL: Override default settings
# DEFAULT_ITERATIONS=2
# IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# SECURITY: Custom HTTP Referer (defaults to github repo if not set)
# Set this to your own domain for production use
# HTTP_REFERER=https://your-domain.com/mockingbird

# SECURITY: Daily token budget limit (prevents runaway spending)
# Set to 0 for unlimited (not recommended)
DAILY_TOKEN_BUDGET=100000

# SECURITY: Maximum prompt length (characters)
MAX_PROMPT_LENGTH=2000
